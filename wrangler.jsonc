{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promptshare",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["global_fetch_strictly_public"],

  // The website is served at https://promptshare.cc (custom domain: infra/worker.tf). The gateway
  // (GatewayMcp) and login (AccountEvents) reach the Worker over Service Bindings.
  "workers_dev": false,
  "preview_urls": false,

  // Invocation logs could record request content.
  "observability": {
    "enabled": false,
  },

  "vars": {
    // The website's origin, and the resource its sign-in tokens are issued for (login's registry).
    "SITE_ORIGIN": "https://promptshare.cc",
    "AUTHORIZATION_SERVER": "https://login.2earl.com",
    // Where assistants connect (the gateway's Prompt share address).
    "MCP_ADDRESS": "https://mcp.2earl.com/promptshare",
  },

  // Set by the deploy workflow from the GitHub `production` environment.
  "secrets": {
    "required": [
      // Encrypts shared-session entries (docs/DESIGN.md §7.1).
      "STATE_ENCRYPTION_KEY",
      // HMAC key for website session and sign-in cookies (only their HMAC is stored).
      "SESSION_PEPPER",
      // The owner's 2earl user ID: the only account that can open the moderation view.
      "OWNER_UID",
    ],
  },

  // Static files: styles, icon. Everything else is the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },

  "services": [
    // Token exchange and validation for the website's sign-in, never over the public Internet.
    { "binding": "AUTH_SERVER", "service": "login" },
  ],

  // Per-network limit on sign-in and on the contact and report forms.
  "ratelimits": [
    {
      "name": "FORM_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 },
    },
  ],

  // Emails the owner when a contact message or a report arrives (LEGAL.md §2, Art. 16). The
  // recipient is the CONTACT_TO secret, so no address is in this repository. Optional: without
  // it, messages are only stored.
  "send_email": [{ "name": "MAILER" }],

  // Created by infra/storage.tf (EU jurisdiction); set after the first terraform apply.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "promptshare",
      "database_id": "431ec74b-e3d1-45bd-b3d2-549b9cd64e9d",
      "migrations_dir": "migrations",
    },
  ],

  // Every 10 minutes: remind the owner of messages unanswered for 30 minutes.
  // Daily at 03:53 UTC: retention (security log, moderation records).
  "triggers": {
    "crons": ["*/10 * * * *", "53 3 * * *"],
  },
}
