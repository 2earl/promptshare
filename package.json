{
  "name": "@2earl/promptshare",
  "version": "0.0.0",
  "private": true,
  "description": "Prompt share at promptshare.cc: share LLM prompts across assistants and conversation state between sessions and people, signed in with 2earl",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types --check && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "hono": "4.13.17",
    "zod": "4.6.7"
  }
}
